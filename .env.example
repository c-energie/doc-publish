# Copy to .env and fill in. Real environment variables always win over this file, so
# CI can set them directly (the site workflow does) and an explicit export in your shell
# is never silently overridden by a stale .env.
#
# Only THESIS_REPO is required. Everything else has a default or gates one feature.

# ---- inputs ----------------------------------------------------------------------
# The LaTeX document repo. Must contain main.tex. Read, never written to.
THESIS_REPO=C:/Users/you/Projects/thesis-latex

# Where publishing state lives. Defaults to $THESIS_REPO/.thesis-agent, which is
# committed in that repo so the state versions with the labels it points at.
# Set this only if you cannot commit to the document repo.
#THESIS_STATE_DIR=

# ---- outputs ---------------------------------------------------------------------
# Derived corpora and figure copies. Defaults to ./build. Holds the draft build -
# keep it out of any repo.
#THESIS_BUILD_DIR=

# The repo that receives the published site. Must be a git repo: `thesis-agent publish`
# writes into it and stops, so the result can be reviewed as a diff before it is
# permanent.
THESIS_PUBLISH_REPO=C:/Users/you/Projects/thesis-publish

# The Quarto project and its rendered output. Both default to inside the build dir, so
# they never collide with the site directory `thesis-agent publish` writes into.
#THESIS_SITE_DIR=
#THESIS_SITE_BUILD_DIR=
# Zipped bundles. Defaults to ./dist.
#THESIS_DIST_DIR=

# How the source is named in generated prose. Defaults to the document repo's
# directory name.
#THESIS_SOURCE_LABEL=corson94/thesis-latex

# ---- Notion stream ---------------------------------------------------------------
# Integration token and the page the wiki is published under. Without both,
# `thesis-agent sync` will not run.
#NOTION_TOKEN=
#THESIS_NOTION_PARENT=
# The project's context.json, for the open-questions database id. Found automatically
# in a sibling thesis-context checkout.
#THESIS_CONTEXT_JSON=

# Base URL for interactive figure exports. Until it is set, figures publish as
# "hosting pending" placeholders rather than broken links.
#FIGURES_BASE_URL=

# ---- chat server (the 'app' extra) -----------------------------------------------
#ANTHROPIC_API_KEY=
# public = source comments stripped, safe to serve. draft = comments kept, author only.
# The publish path refuses to run at all unless this is public.
CORPUS_MODE=public
# Per-record results for query_results / plot_results. Defaults to ./data/results.parquet.
#THESIS_RESULTS=

# Quarto executable, if it is not on PATH.
#QUARTO=
